# Copy this file to .env and fill in your real values.
# .env is never sent to the browser - that's the whole point of this backend.

ALPACA_KEY=your_alpaca_key_here
ALPACA_SECRET=your_alpaca_secret_here

TWELVE_DATA_KEY=your_twelve_data_key_here

# Must be a LIVE Tradier Brokerage token - sandbox accounts cannot stream.
TRADIER_TOKEN=your_tradier_production_token_here

PORT=3000
